{
  "name": "browser-games",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "start": "node server.js",
    "start:29": "yarn build:engine && node .build/29-card/server.js",
    "token:29": "yarn build:engine && node .build/29-card/server.js --generate-token",
    "invite:29": "yarn build:engine && node .build/29-card/server.js --generate-invite",
    "build:ui": "node 29_Card/build-ui.cjs",
    "build": "yarn build:engine && node scripts/build.cjs",
    "build:engine": "tsc -p 29_Card/tsconfig.build.json",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
